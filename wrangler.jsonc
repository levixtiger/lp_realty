{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lin-pan-realty-panel",
  "account_id": "ac11722aea2c9e621745b4c15e3ce2ae",
  "compatibility_date": "2026-05-22",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "members.linpanrealty.com",
      "custom_domain": true
    }
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  }
}
